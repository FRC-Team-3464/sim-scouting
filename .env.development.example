# Copy this file to .env.development and insert your development Firebase
# service-account JSON as a single-line value. Never commit the copied file.
SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-development-project"}
# Browsers require the API to allow the frontend origin because the Vite
# frontend and Express API run on different ports during development.
# Include scheme, host, and port only; do not include a path or trailing slash.
CORS_ALLOWED_ORIGIN=http://localhost:5173
PORT=3000
# Firebase Authentication REST API configuration used only by the Node API.
FIREBASE_WEB_API_KEY=your-development-firebase-web-api-key
# Session and warning durations are configured in whole minutes.
SESSION_DURATION_MINUTES=360
SESSION_EXPIRATION_WARNING_MINUTES=30
# Local development uses HTTP, so Secure must be false. SameSite remains lax.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
