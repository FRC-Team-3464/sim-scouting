# Production secrets should normally be configured directly in the hosting
# platform rather than committed or copied into the repository.
SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-production-project"}
# Exact browser origin permitted by the API's CORS policy.
# Include scheme and host only; do not include a path or trailing slash.
CORS_ALLOWED_ORIGIN=https://3464scouting.vercel.app
PORT=3000
# Firebase Authentication REST API configuration used only by the Node API.
FIREBASE_WEB_API_KEY=your-production-firebase-web-api-key
# Session and warning durations are configured in whole minutes.
SESSION_DURATION_MINUTES=360
SESSION_EXPIRATION_WARNING_MINUTES=30
# Production uses HTTPS and must send session cookies only over secure transport.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
# Store a production-only HMAC key in the hosting platform's secret settings.
# Generate it with: openssl rand -hex 32
CSRF_SECRET=replace-with-the-64-character-command-output
